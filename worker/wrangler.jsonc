{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanzen-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "KANZEN_WORKSPACE",
        "class_name": "KanZenWorkspace"
      }
    ]
  },
  "exports": {
    "KanZenWorkspace": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["SYNC_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
